    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "VALID_AVAILABILITY = sorted(df[\"Availability\"].unique())\n",
        "VALID_LOCATIONS = sorted(df[\"Location\"].unique())\n",
        "\n",
        "prep = final_model.named_steps[\"prep\"]\n",
        "lr = final_model.named_steps[\"model\"]\n",
        "skill_vec = prep.named_transformers_[\"skills\"]\n",
        "skill_analyzer = skill_vec.build_analyzer()\n",
        "skill_vocab = set(skill_vec.vocabulary_)\n",
        "feature_names = prep.get_feature_names_out()\n",
        "\n",
        "def readable(feature):\n",
        "    if feature.startswith(\"skills__\"):\n",
        "        return \"skill: \" + feature.replace(\"skills__\", \"\")\n",
        "    if feature.startswith(\"categories__Availability_\"):\n",
        "        return \"availability: \" + feature.replace(\"categories__Availability_\", \"\")\n",
        "    if feature.startswith(\"categories__Location_\"):\n",
        "        return \"location: \" + feature.replace(\"categories__Location_\", \"\")\n",
        "    return feature\n",
        "\n",
        "def recommend(skills, availability, location, top_n=3):\n",
        "    # 1. validate the input\n",
        "    if not isinstance(skills, str) or not skills.strip():\n",
        "        return {\"ok\": False, \"message\": \"Please enter at least one skill, for example: nursing, first aid.\"}\n",
        "    avail = {a.lower(): a for a in VALID_AVAILABILITY}.get(str(availability).strip().lower())\n",
        "    if avail is None:\n",
        "        return {\"ok\": False, \"message\": \"Availability must be one of: \" + \", \".join(VALID_AVAILABILITY) + \".\"}\n",
        "    loc = {l.lower(): l for l in VALID_LOCATIONS}.get(str(location).strip().lower())\n",
        "    if loc is None:\n",
        "        return {\"ok\": False, \"message\": \"Location must be one of: \" + \", \".join(VALID_LOCATIONS) + \".\"}\n",
        "    words = skill_analyzer(skills.lower())\n",
        "    known = [w for w in words if w in skill_vocab]\n",
        "    unknown = [w for w in words if w not in skill_vocab]\n",
        "    if not known:\n",
        "        return {\"ok\": False, \"message\": \"None of those skills were recognised. Try skills such as teaching, nursing, tree planting or cooking.\"}\n",
        "\n",
        "    # 2. predict\n",
        "    row = pd.DataFrame([{\"Skills\": skills.lower().strip(), \"Availability\": avail, \"Location\": loc}])\n",
        "    probs = final_model.predict_proba(row)[0]\n",
        "\n",
        "    # 3. explain: weight x value for each input, biggest positive ones are the reasons\n",
        "    x = prep.transform(row)\n",
        "    x = x.toarray()[0] if hasattr(x, \"toarray\") else np.asarray(x)[0]\n",
        "    results = []\n",
        "    for i in np.argsort(probs)[::-1][:top_n]:\n",
        "        contrib = lr.coef_[i] * x\n",
        "        top = [j for j in np.argsort(contrib)[::-1][:3] if contrib[j] > 0]\n",
        "        results.append({\"cause\": lr.classes_[i],\n",
        "                        \"confidence\": round(float(probs[i]) * 100, 1),\n",
        "                        \"reasons\": [readable(feature_names[j]) for j in top]})\n",
        "    return {\"ok\": True, \"results\": results, \"ignored_words\": unknown}\n",
        "\n",
        "def show(skills, availability, location):\n",
        "    print(f\"INPUT -> skills: {skills!r}, availability: {availability!r}, location: {location!r}\")\n",
        "    out = recommend(skills, availability, location)\n",
        "    if not out[\"ok\"]:\n",
        "        print(\"  Cannot process:\", out[\"message\"])\n",
        "        print()\n",
        "        return\n",
        "    for rank, r in enumerate(out[\"results\"], 1):\n",
        "        line = f\"  {rank}. {r['cause']} ({r['confidence']}%)\"\n",
        "        if r[\"confidence\"] >= 10:\n",
        "            line += f\"  because of -> {', '.join(r['reasons'])}\"\n",
        "        print(line)\n",
        "    if out[\"results\"][0][\"confidence\"] < 40:\n",
        "        print(\"  Note: low confidence. These skills fit several cause areas.\")\n",
        "    if out[\"ignored_words\"]:\n",
        "        print(\"  Note: these words were not recognised and were ignored:\", \", \".join(out[\"ignored_words\"]))\n",
        "    print()"
      ],
